# ── Supabase Integration ─────────────────────────────────────────
# Your Supabase project URL (found in Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# The anon/public key — safe for the browser (RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key — SERVER ONLY, never expose to the browser!
# Bypasses Row Level Security. Only use in API routes / server components.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma
# Option A — Direct connection (for local dev / prisma db push):
#   postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Option B — Supavisor pooler (for serverless / hosted environments):
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

GEMINI_API_KEY=

DATA_GOV_IN_API_KEY=

AGMARKNET_API_KEY=

